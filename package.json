{
  "name": "angular-personal-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node ./scripts/generate-blog-index.js",
    "gen-index": "node ./scripts/generate-blog-index.js",
    "build": "ng build",
    "postbuild": "node ./scripts/generate-seo-pages.js",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json,md}\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "marked": "^18.1.2",
    "ngx-markdown": "^21.3.0",
    "notebook-viewer-ts": "^0.1.0",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@types/node": "^18.7.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "prettier": "^2.8.8",
    "sass": "^1.93.2",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.3"
  }
}
